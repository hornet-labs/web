---
const features = [
  {
    number: "01",
    title: "A tap that knows",
    description: "Seamless flow so you can focus on pouring the perfect pint.",
  },
  {
    number: "02",
    title: "More good nights",
    description: "Less time waiting, more time around the table.",
  },
  {
    number: "03",
    title: "Made for the real world",
    description: "Thoughtful technology, designed for a social experience.",
  },
];
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8fa" />
    <meta
      name="description"
      content="Kegnetic is making access at the tap simpler. Something good is brewing."
    />
    <title>Kegnetic — Something good is brewing</title>
    <link rel="icon" type="image/svg+xml" href={`${base}kegnetic-mark.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={`${base}#top`} aria-label="Kegnetic home">
          <img src={`${base}kegnetic-mark.svg`} alt="" width="42" height="42" />
          <span>Kegnetic</span>
        </a>
        <span class="status"><span class="status-dot"></span>Something's brewing</span>
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span></span> A fresh take on the tap</p>
            <h1 id="hero-title">A better pour<br />is <span>on tap.</span></h1>
            <p class="hero-description">
              
            </p>
            <a class="scroll-link" href={`${base}#our-approach`}>
              Get to know Kegnetic
              <span aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="hero-art" aria-label="Illustration of a connected beer tap">
            <div class="art-glow"></div>
            <div class="art-note note-top"><span class="note-icon">✳</span> Good things, on tap</div>
            <div class="tap-card">
              <div class="tap-card-top">
                <span class="tap-brand"><img src={`${base}kegnetic-mark.svg`} alt="" /> KEGNETIC</span>
                <span class="tap-live"><span></span> READY</span>
              </div>
              <div class="tap-illustration">
                <div class="tap-halo"></div>
                <div class="tap-shadow"></div>
                <div class="control-panel" aria-hidden="true">
                  <div class="screen-bezel">
                    <div class="screen-display">
                      <div class="screen-topbar">
                        <span class="screen-brand">CHOOSE A POUR</span>
                        <span class="screen-status"><i></i> TAP READY</span>
                      </div>
                      <div class="screen-drinks">
                        <div class="screen-drink">
                          <span class="drink-icon lager"></span>
                          <span class="drink-name">LAGER</span>
                          <span class="drink-price">£5.00</span>
                        </div>
                        <div class="screen-drink">
                          <span class="drink-icon pale"></span>
                          <span class="drink-name">PALE ALE</span>
                          <span class="drink-price">£6.00</span>
                        </div>
                        <div class="screen-drink">
                          <span class="drink-icon stout"></span>
                          <span class="drink-name">STOUT</span>
                          <span class="drink-price">£6.50</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="tap-body">
                  <div class="tap-cap"></div>
                  <div class="tap-neck"></div>
                  <div class="tap-head"><span></span></div>
                  <div class="tap-spout"></div>
                  <div class="tap-handle"></div>
                  <div class="tap-base"></div>
                </div>
                <div class="pour">
                  <i></i><i></i><i></i>
                </div>
                <div class="glass">
                  <div class="foam"></div>
                  <div class="beer"></div>
                </div>
              </div>
              <div class="tap-card-bottom">
                <span>YOUR NEXT ROUND</span>
                <span class="round-arrow" aria-hidden="true">↗</span>
              </div>
            </div>
            <div class="art-note note-bottom"><span class="spark">✦</span> Here's to what's next</div>
          </div>
          <div class="hero-index" aria-hidden="true"><span>01</span><i></i> A NEW KIND OF POUR</div>
        </section>

        <section class="approach" id="our-approach" aria-labelledby="approach-title">
          <div class="approach-heading">
            <p class="eyebrow">A little more about us</p>
            <h2 id="approach-title">The best things<br />bring us <span>together.</span></h2>
          </div>
          <div class="approach-details">
            <p class="approach-intro">
              Kegnetic is rethinking the way people connect. We put you in control of the tap. Simple, 
              social, all powered by a little bit of technology.
            </p>
            <div class="feature-list">
              {features.map((feature) => (
                <article class="feature">
                  <span class="feature-number">{feature.number}</span>
                  <div>
                    <h3>{feature.title}</h3>
                    <p>{feature.description}</p>
                  </div>
                  <span class="feature-arrow" aria-hidden="true">↗</span>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="closing" aria-label="Launch announcement">
          <div class="closing-mark"><img src={`${base}kegnetic-mark.svg`} alt="" /></div>
          <p class="eyebrow">We're just getting started</p>
          <h2>Stay <span>thirsty.</span></h2>
          <p>Our first pour is coming soon.</p>
        </section>
      </main>

      <footer class="site-footer">
        <a class="footer-brand" href={`${base}#top`}>KEGNETIC<span>®</span></a>
        <span>Thoughtfully poured. Coming soon.</span>
        <span>© {new Date().getFullYear()} Kegnetic</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    font-family: "Inter", sans-serif;
    color: #18263b;
    background: #f7f8fa;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-optical-sizing: auto;
    scroll-behavior: smooth;
    --blue: #0068ed;
    --navy: #17243a;
    --muted: #738097;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .page-shell {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 7.2%;
    overflow: hidden;
  }

  .site-header {
    height: 98px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e9edf2;
  }

  .brand,
  .status,
  .tap-brand,
  .tap-live,
  .scroll-link {
    display: inline-flex;
    align-items: center;
  }

  .brand {
    gap: 6px;
    font: 800 19px "Inter", sans-serif;
    letter-spacing: -0.8px;
  }

  .brand img {
    width: 50px;
    height: 50px;
  }

  .status {
    gap: 9px;
    color: #69758a;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .status-dot,
  .tap-live span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f7931e;
    box-shadow: 0 0 0 4px #fff2e4;
  }

  .hero {
    min-height: 650px;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4%;
    padding: 60px 0 92px;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding-bottom: 20px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 23px;
    color: #68758a;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero-copy .eyebrow span {
    width: 22px;
    height: 2px;
    background: #f7931e;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    font-family: "Inter", sans-serif;
  }

  h1 {
    margin-bottom: 24px;
    font-size: clamp(56px, 6.3vw, 88px);
    font-weight: 700;
    letter-spacing: -0.085em;
    line-height: 0.99;
  }

  h1 span,
  .approach-heading h2 span,
  .closing h2 span {
    color: var(--blue);
  }

  .hero-description {
    max-width: 395px;
    margin-bottom: 30px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
  }

  .scroll-link {
    gap: 13px;
    color: var(--navy);
    font-size: 14px;
    font-weight: 700;
  }

  .scroll-link span {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    border: 1px solid #dce2eb;
    border-radius: 50%;
    font-size: 16px;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .scroll-link:hover span {
    color: white;
    background: var(--blue);
    border-color: var(--blue);
    transform: translateY(2px);
  }

  .hero-art {
    min-height: 440px;
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .art-glow {
    width: min(88%, 410px);
    aspect-ratio: 1;
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, #e6efff 0, #edf3fc 48%, #f7f8fa 72%);
  }

  .tap-card {
    width: min(76%, 330px);
    height: 365px;
    position: relative;
    z-index: 1;
    padding: 22px 23px 17px;
    overflow: hidden;
    border: 1px solid rgba(226, 233, 244, 0.8);
    border-radius: 17px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 25px 70px rgba(46, 73, 122, 0.12), 0 3px 10px rgba(46, 73, 122, 0.04);
    transform: rotate(-3deg);
  }

  .tap-card-top,
  .tap-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tap-brand {
    gap: 4px;
    color: #768196;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .tap-brand img {
    width: 21px;
    height: 21px;
  }

  .tap-live {
    gap: 7px;
    color: #79869a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .tap-live span {
    width: 7px;
    height: 7px;
    background: #46c893;
    box-shadow: 0 0 0 3px #e7f9f1;
  }

  .tap-illustration {
    height: 274px;
    position: relative;
  }

  .control-panel {
    width: 194px;
    height: 91px;
    position: absolute;
    z-index: 4;
    top: 8px;
    left: 50%;
    padding: 6px;
    border: 1px solid #6c7480;
    border-radius: 6px;
    background: linear-gradient(135deg, #343a43, #11151a 35%, #050607 72%, #303741);
    box-shadow: 0 7px 14px rgba(17, 27, 44, 0.3), inset 0 0 0 2px #171b20;
    transform: translateX(-50%);
  }

  .screen-display {
    height: 100%;
    padding: 5px;
    overflow: hidden;
    border: 1px solid #314967;
    border-radius: 2px;
    background: linear-gradient(145deg, #10243b, #071426);
  }

  .screen-bezel {
    height: 100%;
  }

  .screen-topbar {
    height: 12px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    color: #dceaff;
    font-size: 5px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .screen-brand {
    color: #78b9ff;
  }

  .screen-status {
    display: flex;
    align-items: center;
    gap: 3px;
    color: #a7c0db;
    font-size: 4px;
  }

  .screen-status i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #49d49a;
    box-shadow: 0 0 4px rgba(73, 212, 154, 0.75);
  }

  .screen-drinks {
    height: calc(100% - 12px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .screen-drink {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    border: 1px solid rgba(126, 174, 226, 0.35);
    border-radius: 2px;
    background: linear-gradient(160deg, rgba(55, 119, 181, 0.8), rgba(17, 50, 84, 0.92));
    color: #edf5ff;
  }

  .screen-drink:nth-child(2) {
    background: linear-gradient(160deg, rgba(60, 127, 191, 0.85), rgba(24, 58, 91, 0.94));
  }

  .screen-drink:nth-child(3) {
    background: linear-gradient(160deg, rgba(54, 105, 156, 0.85), rgba(20, 45, 70, 0.95));
  }

  .drink-icon {
    width: 13px;
    height: 13px;
    position: relative;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 62%, #f6c55e 0 35%, #de962c 37% 55%, #3b8bd1 57%);
    box-shadow: 0 0 5px rgba(105, 183, 255, 0.4);
  }

  .drink-icon::after {
    width: 6px;
    height: 2px;
    position: absolute;
    top: 3px;
    left: 3px;
    border-radius: 3px;
    background: #fff3d4;
    content: "";
  }

  .drink-icon.pale {
    background: radial-gradient(circle at 50% 62%, #eaaa43 0 35%, #bd7323 37% 55%, #34a3d8 57%);
  }

  .drink-icon.stout {
    background: radial-gradient(circle at 50% 62%, #88532c 0 35%, #4b3027 37% 55%, #3d83c4 57%);
  }

  .drink-name {
    font-size: 5px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .drink-price {
    color: #b6d5f4;
    font-size: 4px;
  }

  .tap-halo {
    width: 212px;
    height: 212px;
    position: absolute;
    top: 28px;
    left: 50%;
    border-radius: 50%;
    background: linear-gradient(145deg, #eef5ff 3%, #dfeaff 100%);
    transform: translateX(-50%);
  }

  .tap-shadow {
    width: 174px;
    height: 20px;
    position: absolute;
    z-index: 1;
    bottom: 29px;
    left: 50%;
    border-radius: 50%;
    background: rgba(45, 75, 127, 0.12);
    filter: blur(7px);
    transform: translateX(-50%);
  }

  .tap-body {
    width: 132px;
    height: 160px;
    position: absolute;
    z-index: 2;
    top: 90px;
    left: 50%;
    transform: translateX(-50%);
    transform-origin: top center;
  }

  .tap-cap {
    width: 48px;
    height: 12px;
    position: absolute;
    top: 0;
    left: 42px;
    border: 1px solid #919dad;
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(90deg, #707e90, #eef3f8 24%, #9daaba 52%, #e1e7ed 76%, #69778a);
    box-shadow: 0 2px 3px rgba(27, 40, 58, 0.2);
  }

  .tap-neck {
    width: 42px;
    height: 54px;
    position: absolute;
    top: 9px;
    left: 45px;
    border: 1px solid #8491a2;
    border-radius: 3px 3px 6px 6px;
    background: linear-gradient(90deg, #606e80, #f3f5f7 18%, #abb6c3 42%, #f8fafb 58%, #8794a5 83%, #566477);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.12), 0 4px 8px rgba(23, 36, 58, 0.18);
  }

  .tap-head {
    width: 116px;
    height: 40px;
    position: absolute;
    top: 45px;
    left: 8px;
    border: 1px solid #788699;
    border-radius: 7px 7px 10px 10px;
    background: linear-gradient(105deg, #657286, #e8edf2 18%, #9ba8b7 38%, #f4f6f8 52%, #8996a7 77%, #556376);
    box-shadow: inset 0 -5px 8px rgba(37, 51, 70, 0.2), 0 6px 10px rgba(26, 40, 62, 0.2);
  }

  .tap-head::after {
    width: 47px;
    height: 2px;
    position: absolute;
    top: 8px;
    left: 34px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.65);
    content: "";
  }

  .tap-head span {
    width: 7px;
    height: 7px;
    position: absolute;
    top: 27px;
    left: 54px;
    border: 2px solid #58aaff;
    border-radius: 50%;
    box-shadow: 0 0 7px rgba(75, 161, 255, 0.75);
  }

  .tap-spout {
    width: 15px;
    height: 18px;
    position: absolute;
    z-index: 2;
    top: 78px;
    left: 59px;
    border: 1px solid #7d8b9b;
    border-top: 0;
    border-radius: 0 0 3px 3px;
    background: linear-gradient(90deg, #6e7c8e, #f4f6f8 35%, #9ca9b8 72%, #627084);
  }

  .tap-spout::after {
    width: 19px;
    height: 4px;
    position: absolute;
    bottom: -2px;
    left: -3px;
    border: 1px solid #778598;
    border-radius: 2px;
    background: linear-gradient(#f3f5f7, #8b98a8);
    content: "";
  }

  .tap-handle {
    width: 8px;
    height: 43px;
    position: absolute;
    top: 24px;
    left: 23px;
    border: 1px solid #454e5c;
    border-radius: 4px;
    background: linear-gradient(90deg, #202938, #596578 45%, #2a3444);
    box-shadow: 1px 3px 5px rgba(22, 33, 50, 0.2);
    transform: rotate(18deg);
  }

  .tap-handle::before {
    width: 23px;
    height: 10px;
    position: absolute;
    top: -7px;
    left: -9px;
    border: 1px solid #424d5c;
    border-radius: 4px;
    background: linear-gradient(90deg, #222b38, #667287 50%, #263140);
    content: "";
  }

  .tap-base {
    width: 100px;
    height: 16px;
    position: absolute;
    top: 83px;
    left: 16px;
    border: 1px solid #7c8999;
    border-radius: 3px 3px 7px 7px;
    background: linear-gradient(100deg, #647185, #edf1f5 20%, #8d9aac 49%, #f5f7f9 69%, #677589);
    box-shadow: inset 0 -3px 4px rgba(37, 51, 70, 0.18), 0 4px 7px rgba(23, 36, 58, 0.18);
  }

  .tap-base::before {
    width: 108px;
    height: 5px;
    position: absolute;
    bottom: -4px;
    left: -5px;
    border: 1px solid #788699;
    border-radius: 0 0 5px 5px;
    background: linear-gradient(90deg, #59677a, #e6eaef 35%, #7d8a9a 72%, #59677a);
    content: "";
  }

  .glass {
    width: 37px;
    height: 65px;
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 12px;
    overflow: hidden;
    border: 1px solid rgba(104, 140, 183, 0.65);
    border-top: 0;
    border-radius: 3px 3px 9px 9px;
    background: linear-gradient(90deg, rgba(207, 226, 246, 0.18), rgba(255, 255, 255, 0.72), rgba(207, 226, 246, 0.24));
    clip-path: polygon(0 0, 100% 0, 87% 100%, 13% 100%);
    transform: translateX(-50%);
  }

  .foam {
    height: 18px;
    position: absolute;
    z-index: 2;
    top: 7px;
    right: 0;
    left: 0;
    border-radius: 50% 50% 0 0;
    background: #fff3d9;
  }

  .beer {
    position: absolute;
    top: 14px;
    right: 0;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, #dc8d22, #f6bd52 55%, #d98519);
  }

  .pour {
    width: 7px;
    height: 11px;
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 77px;
    display: flex;
    justify-content: space-between;
    transform: translateX(-50%);
  }

  .pour i {
    width: 2px;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(#f6c967, #df901e);
  }

  .pour i:nth-child(2) {
    height: 80%;
    margin-top: 6px;
  }

  .pour i:nth-child(3) {
    height: 60%;
    margin-top: 12px;
  }

  .tap-card-bottom {
    padding-top: 13px;
    border-top: 1px solid #edf0f5;
    color: #8691a3;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .round-arrow {
    color: #8491a6;
    font-size: 14px;
  }

  .art-note {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 15px;
    border: 1px solid rgba(226, 233, 244, 0.84);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 10px 25px rgba(46, 73, 122, 0.07);
    color: #58667d;
    font-size: 10px;
    font-weight: 600;
  }

  .note-top {
    top: 77px;
    right: -6px;
  }

  .note-bottom {
    bottom: 58px;
    left: 2px;
  }

  .note-icon {
    color: var(--blue);
    font-size: 15px;
  }

  .spark {
    color: #f7931e;
    font-size: 14px;
  }

  .hero-index {
    position: absolute;
    bottom: 35px;
    left: 0;
    display: flex;
    align-items: center;
    gap: 13px;
    color: #8994a5;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .hero-index span {
